<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.example.pojo.entity">
    <class name="OrderDetail" table="order_detail">
        <id name="id" column="detail_id">
            <generator class="identity"/>
        </id>

        <!-- 訂單對應：多對一 -->
        <many-to-one name="order" class="Order" column="order_id" not-null="true"/>

        <property name="productId" column="product_id"/>
        <property name="quantity" column="quantity"/>
        <property name="unitPrice" column="unit_price"/>
    </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.example.pojo.entity">

    <class name="Cart" table="cart">
        <!-- ✅ 主鍵 cart_id 對應 getId()/setId() -->
        <id name="id" column="cart_id">
            <generator class="identity"/>
        </id>

        <!-- ✅ 使用者主鍵 ID 對應欄位 user_id，型別為 String -->
        <property name="userId" column="user_id" type="string"/>

        <!-- 建立時間 -->
        <property name="createTime" column="create_time"/>

        <!-- ✅ 1對多明細關聯：fetch="join" 立即抓取 -->
        <set name="details" cascade="all" inverse="true" fetch="join">
            <key column="cart_id"/>
            <one-to-many class="CartDetail"/>
        </set>
    </class>

</hibernate-mapping>

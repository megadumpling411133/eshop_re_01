<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.example.pojo.entity">
    <class name="CartDetail" table="cart_detail">
        <!-- ✅ 統一主鍵名稱為 id -->
        <id name="id" column="detail_id">
            <generator class="identity"/>
        </id>

        <many-to-one name="cart" column="cart_id" class="Cart" not-null="true"/>
        <property name="productId" column="product_id"/>
        <property name="quantity" column="quantity"/>
        <property name="unitPrice" column="unit_price"/>
    </class>
</hibernate-mapping>

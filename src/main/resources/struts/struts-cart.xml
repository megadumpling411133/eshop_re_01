<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.1//EN"
    "http://struts.apache.org/dtds/struts-2.1.dtd">

<struts>
    <package name="cart" namespace="/cart" extends="struts-default,json-default">

        <!-- ✅ AJAX 加入購物車：回傳 JSON 給 JS -->
        <action name="add" class="com.example.action.CartAction" method="addToCart">
            <result name="json" type="json">
                <param name="root">jsonResult</param>
            </result>
        </action>

        <!-- ✅ 顯示購物車內容頁 -->
        <action name="view" class="com.example.action.CartViewAction">
            <result name="success">/WEB-INF/views/cart/cart.jsp</result>
        </action>

    </package>
</struts>
